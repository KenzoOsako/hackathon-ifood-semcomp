# Copie para .env e preencha. Nunca commitar o .env.
# Trello (usado pelo MCP do Trello; configurado pelo Arthur)
TRELLO_API_KEY=
TRELLO_TOKEN=

# iFood MCP (preencher com as credenciais do agente; NUNCA commitar o .env)
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CALLBACK_PORT=8080
# Opcional: redirect completo (sobrepõe a porta). Tem que ser igual ao cadastrado no portal.
IFOOD_REDIRECT_URI=
# Opcional: local da demo quando o usuário não tem endereço (padrão: USP São Carlos).
IFOOD_DEMO_LAT=
IFOOD_DEMO_LNG=

# Demo (Next.js). MCP_MODE=mock usa fixtures/; real exige o agente aprovado e OAuth (frente Agente e MCP).
MCP_MODE=mock
# Modo real: MCP_MODE=real e rodar na porta do redirect (npx next start -p 8080); login iFood em /api/auth/login.
# Agente (/api/converse): provedor e modelo do LLM via LangChain. Vazios = modo por regras (sem LLM).
# LLM_PROVIDER: anthropic | openai | google. LLM_MODEL: id do modelo no provedor.
LLM_PROVIDER=
LLM_MODEL=
# Chave do provedor escolhido (só a dele). Nunca commitar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Voz (ElevenLabs Pro)
ELEVENLABS_API_KEY=

# Voz (ElevenLabs): ID da voz brasileira e modelo de síntese. Só valores locais, nunca no repositório.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TTS_CHAR_BUDGET=100000
ELEVENLABS_STT_MODEL=scribe_v2
STT_SECONDS_BUDGET=3600

# Opcional: modelo só do atendente (padrão: LLM_MODEL). Ex.: gemini-3.5-flash para conduzir melhor.
ATENDENTE_MODEL=
