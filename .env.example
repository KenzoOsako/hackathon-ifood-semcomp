# Copie para .env e preencha. Nunca commitar o .env.
# Trello (usado pelo MCP do Trello; configurado pelo Arthur)
TRELLO_API_KEY=
TRELLO_TOKEN=

# iFood MCP (preencher com as credenciais do agente; NUNCA commitar o .env)
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CALLBACK_PORT=8080

# Demo (Next.js). MCP_MODE=mock usa fixtures/; real exige o agente aprovado e OAuth (frente Agente e MCP).
MCP_MODE=mock
# Chave de LLM única do time (provedor a confirmar). Nunca commitar.
ANTHROPIC_API_KEY=
# Voz (ElevenLabs Pro)
ELEVENLABS_API_KEY=

# Voz (ElevenLabs): ID da voz brasileira e modelo de síntese. Só valores locais, nunca no repositório.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TTS_CHAR_BUDGET=100000
