# Copie para .env (ou .env.local) e preencha. NUNCA commitar o .env: ele está no .gitignore.
# Valores das chaves compartilhadas do time: peça por mensagem direta ao Felipe.

# Quem está rodando (atribui o consumo de tokens medido em .usage/).
DEV_NAME=seu-nome

# Demo (Next.js). MCP_MODE=mock usa fixtures/; real exige o agente aprovado e OAuth (frente Agente e MCP).
MCP_MODE=mock

# Modelo de linguagem do agente (chave única do time; provedor a confirmar).
ANTHROPIC_API_KEY=

# Voz (ElevenLabs). Chave restrita: TTS, STT, Voices(read), Models, ElevenAgents(read).
ELEVENLABS_API_KEY=

# Controle de gastos por pessoa (0 = sem limite). Medido localmente; veja src/usage/meter.ts.
LLM_TOKEN_BUDGET=2000000
TTS_CHAR_BUDGET=200000
STT_SECONDS_BUDGET=3600
# Opcional: preço por 1 milhão de tokens (USD) para estimar custo. Conferir na tabela do provedor.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# iFood MCP: credenciais do agente aprovado. Os termos restringem compartilhar; cada um usa as suas.
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Callback do app local (deve bater EXATAMENTE com o cadastrado no portal).
IFOOD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Trello (usado pelo MCP do Trello; configurado pelo Arthur)
TRELLO_API_KEY=
TRELLO_TOKEN=
